[Unit]
Description=VW SmartThings Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=luca
WorkingDirectory=/home/luca/scripts/vw-bridge
EnvironmentFile=/home/luca/scripts/vw-bridge/.env
ExecStart=/home/luca/scripts/vw-bridge/venv/bin/python3 main.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/luca/scripts/vw-bridge
UMask=0077

[Install]
WantedBy=multi-user.target